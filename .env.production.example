# A deployment's environment. Copy to .env.production, fill every line, keep it out of
# git (it is already ignored) and off shared drives. Nothing here has a default: the app
# exits 78 at startup rather than guessing, so a missing value fails the deploy, not a
# request three days later.

# staging or production. Both are "hardened": https origin, Secure cookies, HSTS, a
# 48+ character secret, and no demo accounts allowed past ops:preflight.
APP_PROFILE=production

# local, or oidc to add the organisation's OpenID Connect provider (Keycloak, Entra ID,
# Okta, ...) as a sign-in method. Either way identities are created by admin invitation:
# SSO authenticates an invited person, it never provisions an account.
AUTH_MODE=local
# Only when AUTH_MODE=oidc. The issuer is the URL whose /.well-known/openid-configuration
# answers (https); register https://<APP_URL>/api/auth/callback/sso as the redirect URI,
# authorization code + PKCE, scopes openid email profile. OIDC_LABEL is the button text.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Akun perusahaan

# off, or weknora-local when a WeKnora you run yourself answers on the internal network.
AI_PROVIDER=off

STORAGE_DRIVER=filesystem

# Email for what the bell shows (review assignments, decisions, publication, due
# reviews, feedback), batched per person a few minutes after the event. off (default),
# or smtp with the organisation's relay: smtps://user:pass@relay:465 for TLS on
# connect, smtp://relay:587 for STARTTLS (a relay that cannot upgrade is refused).
# URL-encode a user or password with @ or # in it. Everyone can switch their own mail
# off in Pengaturan.
MAIL_MODE=off
SMTP_URL=
MAIL_FROM=IntraDocs <noreply@intradocs.example.org>

# Exactly the origin people type, with https. No path, no trailing slash, no port unless
# the public URL really has one. Cookies and the origin check both key off this.
APP_URL=https://intradocs.example.org

# Separate roles for app, auth and worker -- never the owner role.
#
# With the postgres service from compose.prod.yaml (host "postgres", same private network
# on one machine) use the lines below as they are; DATABASE_PRIVATE_NETWORK=true is the
# written acknowledgement that the link never leaves the host.
# With a database on ANOTHER machine: change the host, append ?sslmode=verify-full to each
# URL, and set DATABASE_PRIVATE_NETWORK=false. The app refuses to start with neither.
DATABASE_URL=postgres://intradocs_app:CHANGE@postgres:5432/intradocs
AUTH_DATABASE_URL=postgres://intradocs_auth:CHANGE@postgres:5432/intradocs
WORKER_DATABASE_URL=postgres://intradocs_worker:CHANGE@postgres:5432/intradocs
DATABASE_PRIVATE_NETWORK=true
# Owner role. Needed only by `pnpm db:migrate` and `pnpm ops:bootstrap-admin`; do not
# give it to the running application.
DATABASE_ADMIN_URL=postgres://intradocs_owner:CHANGE@127.0.0.1:5432/intradocs

# 48+ random characters. Generate, never invent:
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out; that is the intended way to end all sessions at once.
BETTER_AUTH_SECRET=

# Absolute path on a volume the web and worker containers share. Never under a webroot.
STORAGE_ROOT=/data/storage

# Postgres superuser password for the bundled database service in compose.prod.yaml.
POSTGRES_PASSWORD=

# The image tag this environment runs. Pin it: `latest` makes a rollback ambiguous.
INTRADOCS_IMAGE=intradocs:0.3.0
# Loopback port the reverse proxy forwards to.
WEB_PORT=3000

# Only when AI_PROVIDER=weknora-local. WeKnora must stay on the internal network.
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
WEKNORA_KNOWLEDGE_BASE_ID=
WEKNORA_TENANT_ID=
