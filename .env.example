
# --- Generasi jawaban oleh provider eksternal (opsional, default mati) ---
# Mengaktifkan ini mengirim pertanyaan dan potongan dokumen terpilih ke internet.
# Hanya untuk corpus sintetis. Jangan dipakai untuk dokumen nyata atau rahasia.
# AI_GENERATION_LOCATION=external
# AI_EXTERNAL_ACKNOWLEDGED=synthetic-corpus-only
# EXTERNAL_MODEL_SOURCE=openai
# EXTERNAL_MODEL_NAME=gpt-4o-mini
# EXTERNAL_MODEL_BASE_URL=https://api.openai.com/v1
# EXTERNAL_MODEL_API_KEY=
# WEKNORA_SSRF_WHITELIST_EXTRA=host.docker.internal,api.openai.com
